{
  "navigationFallback": {
    "rewrite": "/index.html"
  },
  "routes": [
    {
      "route": "/api/ai-beacon",
      "methods": ["POST", "OPTIONS"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/beacon",
      "methods": ["POST", "OPTIONS"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/verify",
      "methods": ["POST", "OPTIONS"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/register",
      "methods": ["POST", "OPTIONS"],
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/config",
      "methods": ["POST", "OPTIONS"],
      "allowedRoles": ["anonymous"]
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html"
    }
  },
  "globalHeaders": {
    "content-security-policy": "default-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com; X-Content-Type-Options: nosniff; X-Frame-Options: DENY"
  }
}
